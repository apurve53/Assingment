{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server Attach",
            "port": 3001,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
        },
        {
            "name": "Test.js Launch ",
            "program": "${workspaceFolder}/test.js",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "server Launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\server.js"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Server 2",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server.js", // Adjust path to use forward slashes
            "runtimeExecutable": "node", // Ensure Node.js is used
            "console": "integratedTerminal", // Use the integrated terminal for logs
            "restart": true, // Restart the debugger if the server restarts
            "sourceMaps": true, // Enable source maps if you're using TypeScript or transpilers
            "env": { // Optional: Define environment variables
                "NODE_ENV": "development"
            }
        }
    ]
}